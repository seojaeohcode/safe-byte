CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
OCR_PROVIDER=clova
ALLOW_PAID_OCR=false
OCR_DAILY_LIMIT=10
OCR_CACHE_ENABLED=true
OCR_MAX_IMAGE_MB=3
OCR_MAX_UPLOAD_MB=10
OCR_MAX_LONG_EDGE=1600
OCR_JPEG_QUALITY=85
PUBLIC_API_LIVE_HEALTH=false
SAFEBYTE_SQLITE_PATH=data/safe_byte.sqlite3
SAMPLE_IMAGES_PATH=data/selected_ocr_samples
NCLOUD_COST_SNAPSHOT_PATH=config/ncloud_cost_snapshot.json
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
APP_UID=1000
APP_GID=1000
HTTP_PORT=8080
ENABLE_DOCS=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
